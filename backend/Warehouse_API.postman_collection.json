					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Electronics & Gadgets\",\n  \"description\": \"Updated description\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/categories/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "categories", "1"]
						}
					}
				}
			]
		},
		{
			"name": "Items",
			"item": [
				{
					"name": "Create Item (Admin)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Laptop Dell XPS 15\",\n  \"sku\": \"LAP-DELL-XPS15-001\",\n  \"barcode\": \"BC1234567890\",\n  \"supplier\": \"Dell Inc.\",\n  \"categoryId\": 1,\n  \"initialQuantity\": 10,\n  \"lowStockThreshold\": 3,\n  \"status\": \"AVAILABLE\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/items",
							"host": ["{{baseUrl}}"],
							"path": ["api", "items"]
						}
					}
				},
