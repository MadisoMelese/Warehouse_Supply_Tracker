								"value": "Bearer {{userToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/movements?type=OUTBOUND&status=PENDING&itemId=1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "movements"],
							"query": [
								{
									"key": "type",
									"value": "OUTBOUND"
								},
								{
									"key": "status",
									"value": "PENDING"
								},
								{
									"key": "itemId",
									"value": "1"
								}
							]
						}
					}
				},
				{
					"name": "Get Movement by ID",
					"request": {
						"method": "GET",
						"header": [
