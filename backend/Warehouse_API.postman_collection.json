					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{userToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/items?status=AVAILABLE&categoryId=1&search=laptop",
							"host": ["{{baseUrl}}"],
							"path": ["api", "items"],
							"query": [
								{
									"key": "status",
									"value": "AVAILABLE"
								},
								{
									"key": "categoryId",
									"value": "1"
								},
								{
									"key": "search",
									"value": "laptop"
								}
							]
						}
					}
				},
				{
					"name": "Get Item by ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{userToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/items/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "items", "1"]
						}
					}
				},
				{
					"name": "Get Item by Barcode",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{userToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/items/BC1234567890",
							"host": ["{{baseUrl}}"],
							"path": ["api", "items", "BC1234567890"]
						}
					}
				},
				{
					"name": "Update Item (Admin)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Laptop Dell XPS 15 (Updated)\",\n  \"status\": \"ISSUED\",\n  \"lowStockThreshold\": 5\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/items/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "items", "1"]
						}
					}
				},
				{
					"name": "Delete Item (Admin)",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/items/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "items", "1"]
						}
					}
				}
			]
		},
		{
			"name": "Movements",
			"item": [
				{
					"name": "Request Inbound Movement (User)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{userToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"itemId\": 1,\n  \"type\": \"INBOUND\",\n  \"quantity\": 5,\n  \"notes\": \"New stock received from supplier\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/movements",
							"host": ["{{baseUrl}}"],
							"path": ["api", "movements"]
						}
					}
				},
				{
					"name": "Request Outbound Movement (User)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{userToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"itemId\": 1,\n  \"type\": \"OUTBOUND\",\n  \"quantity\": 2,\n  \"notes\": \"Need for project deployment\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/movements",
							"host": ["{{baseUrl}}"],
							"path": ["api", "movements"]
						}
					}
				},
