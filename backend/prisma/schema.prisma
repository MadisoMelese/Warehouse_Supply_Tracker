generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Item {
  id               Int          @id @default(autoincrement())
  name             String
  sku              String       @unique
  barcode          String       @unique
  supplier         String?
  category         Category     @relation(fields: [categoryId], references: [id])
  categoryId       Int
  status           ItemStatus   @default(AVAILABLE)
  initialQuantity  Int
  currentStock     Int          @default(0)
  lowStockThreshold Int         @default(5)
  movements        Movement[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  items       Item[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Movement {
  id          Int            @id @default(autoincrement())
  item        Item           @relation(fields: [itemId], references: [id])
  itemId      Int
  type        MovementType
  quantity    Int
  status      MovementStatus @default(PENDING)
  requestedBy User           @relation("RequestedMovements", fields: [requestedById], references: [id])
  requestedById Int
  approvedBy  User?          @relation("ApprovedMovements", fields: [approvedById], references: [id])
  approvedById Int?
  isReturned  Boolean        @default(false)
  returnedAt  DateTime?
  notes       String?
  timestamp   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

enum MovementType {
  INBOUND
  OUTBOUND
}

enum MovementStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ItemStatus {
  AVAILABLE
  ISSUED
}

model User {
  id                Int         @id @default(autoincrement())
  email             String      @unique
  password          String
  role              UserRole    @default(USER)
  requestedMovements Movement[] @relation("RequestedMovements")
  approvedMovements Movement[]  @relation("ApprovedMovements")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

enum UserRole {
  USER
  ADMIN
}
